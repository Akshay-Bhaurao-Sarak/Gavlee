<% layout("/layouts/boilerplate") %>
<main class="gavlee-home">
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-hero-inner">
      <div class="home-hero-copy">
        <p class="home-kicker"><span></span> A LITTLE MORE GOODNESS, EVERY DAY</p>
        <h1 id="home-title">Make room for<br><em>the good stuff.</em></h1>
        <p class="home-hero-description">Everyday dairy favourites and feel-good treats, brought together for your table.</p>
        <div class="home-hero-actions">
          <a class="home-button home-button-dark" href="/listings">Explore all products <span aria-hidden="true">↗</span></a>
          <a class="home-text-link" href="#our-way">Get to know Gavlee <span aria-hidden="true">↓</span></a>
        </div>
        <div class="home-hero-note"><span class="home-note-mark">G</span><span>Good food has a way<br>of bringing us together.</span></div>
      </div>
      <div class="home-hero-art" aria-label="Gavlee dairy favourites" role="img">
        <div class="home-art-sun"></div>
        <div class="home-art-label">MADE FOR<br>YOUR EVERYDAY</div>
        <img class="home-art-main" src="/images/milk.jpeg" alt="A bottle of Gavlee milk">
        <img class="home-art-small" src="/images/ghee.jpeg" alt="Gavlee golden ghee">
        <span class="home-art-sparkle" aria-hidden="true">✳</span>
      </div>
    </div>
    <div class="home-hero-bottom"><span>GOODNESS YOU CAN COME BACK TO</span><span>SCROLL TO EXPLORE&nbsp; ↓</span></div>
  </section>

  <section class="home-categories" aria-labelledby="category-title">
    <div class="home-section-heading">
      <div><p class="home-kicker">FIND YOUR FAVOURITE</p><h2 id="category-title">A good place to start.</h2></div>
      <a class="home-inline-link" href="/listings">View all products <span aria-hidden="true">↗</span></a>
    </div>
    <div class="home-category-grid">
      <a class="home-category home-category-milk" href="/listings"><span class="home-category-number">01 / EVERYDAY</span><img src="/images/milk.jpeg" alt="Milk"><span class="home-category-name">Daily essentials <b>↗</b></span></a>
      <a class="home-category home-category-ghee" href="/listings"><span class="home-category-number">02 / THE CLASSICS</span><img src="/images/ghee.jpeg" alt="Golden ghee"><span class="home-category-name">Rich &amp; golden <b>↗</b></span></a>
      <a class="home-category home-category-paneer" href="/listings"><span class="home-category-number">03 / MADE TO SHARE</span><img src="/images/paneer.jpeg" alt="Paneer"><span class="home-category-name">Kitchen favourites <b>↗</b></span></a>
      <a class="home-category home-category-treats" href="/listings"><span class="home-category-number">04 / A LITTLE TREAT</span><img src="/images/Ice_creams.jpeg" alt="Ice cream"><span class="home-category-name">Sweet moments <b>↗</b></span></a>
    </div>
  </section>

  <section class="home-story" id="our-way" aria-labelledby="story-title">
    <div class="home-story-image"><img src="/images/curd.jpeg" alt="A bowl of creamy Gavlee curd"><span>GAVLEE<br>GOODNESS</span></div>
    <div class="home-story-copy"><p class="home-kicker">A SIMPLE THING, DONE WITH CARE</p><h2 id="story-title">The little things<br>make a meal.</h2><p>Morning chai, a favourite family recipe, one last spoonful of dessert. Gavlee brings together the dairy staples and small delights that make everyday moments feel special.</p><a class="home-button home-button-green" href="/listings">Find your favourites <span aria-hidden="true">↗</span></a></div>
    <div class="home-story-aside" aria-hidden="true">GOOD THINGS<br>GROW AROUND<br>THE TABLE.</div>
  </section>

  <section class="home-endcap">
    <p class="home-kicker">YOUR NEXT FAVOURITE IS WAITING</p>
    <h2>Bring a little<br><em>Gavlee home.</em></h2>
    <a class="home-button home-button-light" href="/listings">Browse all products <span aria-hidden="true">↗</span></a>
    <span class="home-endcap-flower" aria-hidden="true">✳</span>
  </section>
</main>
