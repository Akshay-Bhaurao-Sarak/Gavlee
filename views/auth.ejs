<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= mode === "register" || stage !== "start" ? "Create account" : "Sign in" %> | Gavlee</title>
  <link rel="icon" href="/gavlee-favicon-large.ico"><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css"><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"><link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-body"><main class="auth-page">
  <section class="auth-card" aria-labelledby="auth-title">
    <a class="auth-logo" href="/" aria-label="Gavlee home"><img src="/logo.png" alt="Gavlee"></a>
    <% if (stage === "verify" || stage === "finish") { %>
      <p class="auth-eyebrow">CREATE YOUR ACCOUNT</p>
      <h1 id="auth-title"><%= stage === "verify" ? "Verify your email" : "Finish setting up" %></h1>
      <% if (error) { %><div class="auth-alert" role="alert"><%= error %></div><% } %>
      <% if (stage === "verify") { %>
        <p class="auth-intro">We sent a six-digit code to <strong><%= email %></strong>.</p>
        <form action="/register/verify" method="post" class="auth-form">
          <input type="hidden" name="email" value="<%= email %>">
          <label for="otp">Email verification code</label>
          <input id="otp" name="otp" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" placeholder="000000" required>
          <button class="auth-submit" type="submit">Verify email</button>
        </form>
        <form action="/register/resend" method="post" class="auth-resend"><input type="hidden" name="email" value="<%= email %>"><button type="submit">Resend code</button></form>
      <% } else { %>
        <p class="auth-intro">Choose a password and add your profile details.</p>
        <form action="/register/complete" method="post" class="auth-form">
          <input type="hidden" name="email" value="<%= email %>">
          <input id="avatar-data" name="avatarData" type="hidden">
          <div class="profile-picker">
            <label class="profile-picture" for="avatar"><img id="avatar-preview" src="/images/general.jpeg" alt="Profile photo preview"><span><i class="fa-solid fa-pen"></i></span></label>
            <input id="avatar" name="avatar" type="file" accept="image/*" hidden>
            <small>Profile photo (optional)</small>
          </div>
          <label for="name">Name <span>Optional</span></label><input id="name" name="name" type="text" autocomplete="name" maxlength="80" placeholder="Your name">
          <label for="password">Password</label><input id="password" name="password" type="password" autocomplete="new-password" minlength="8" required>
          <label for="confirmPassword">Confirm password</label><input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" minlength="8" required>
          <button class="auth-submit" type="submit">Create account</button>
        </form>
      <% } %>
      <p class="auth-switch"><a href="/login">Back to sign in</a></p>
    <% } else { %>
      <p class="auth-eyebrow">WELCOME TO GAVLEE</p>
      <h1 id="auth-title"><%= mode === "register" ? "Create your account" : "Sign in to your account" %></h1>
      <p class="auth-intro"><%= mode === "register" ? "Start shopping and keep your place." : "Continue where you left off." %></p>
      <% if (error) { %><div class="auth-alert" role="alert"><%= error %></div><% } %>
      <form action="<%= mode === "register" ? "/register" : "/login" %>" method="post" class="auth-form">
        <label for="email">Email address</label><input id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required>
        <% if (mode === "login") { %>
          <label for="password">Password</label><input id="password" name="password" type="password" autocomplete="current-password" required>
          <button class="auth-submit" type="submit">Sign in</button>
        <% } else { %><button class="auth-submit" type="submit">Continue with email</button><% } %>
      </form>
      <p class="auth-switch"><%= mode === "register" ? "Already registered?" : "New to Gavlee?" %> <a href="<%= mode === "register" ? "/login" : "/register" %>"><%= mode === "register" ? "Sign in" : "Create an account" %></a></p>
    <% } %>
    <p class="auth-legal">By continuing, you agree to Gavlee's <a href="/terms">Terms</a> and <a href="/privacy">Privacy Policy</a>.</p>
  </section>
</main>
<script>
  document.getElementById("avatar")?.addEventListener("change", function () {
    const file = this.files && this.files[0];
    if (!file) return;
    if (!file.type.startsWith("image/") || file.size > 2 * 1024 * 1024) { this.value = ""; alert("Choose an image smaller than 2 MB."); return; }
    const reader = new FileReader();
    reader.onload = () => { document.getElementById("avatar-preview").src = reader.result; document.getElementById("avatar-data").value = reader.result; };
    reader.readAsDataURL(file);
  });
</script></body></html>
