<% layout("/layouts/boilerplate") %>
<main class="gavlee-home">
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-hero-inner">
      <div class="home-hero-copy">
        <p class="home-kicker"><span></span> A LITTLE MORE GOODNESS, EVERY DAY</p>
        <h1 id="home-title">Make room for<br><em>the good stuff.</em></h1>
        <p class="home-hero-description">Everyday dairy favourites and feel-good treats, brought together for your table.</p>
        <div class="home-hero-actions">
          <a class="home-button home-button-dark" href="/listings">Explore all products</a>
        </div>
      </div>
      <div class="home-hero-art" aria-label="Gavlee dairy favourites" role="img">
        <img class="home-art-main" src="/hero%20img.png" alt="Gavlee's samurai cow mascot against a red sun">
      </div>
    </div>
  </section>

  <section class="home-categories" aria-labelledby="category-title">
    <div class="home-section-heading">
      <div><p class="home-kicker">FIND YOUR FAVOURITE</p><h2 id="category-title">A good place to start.</h2></div>
      <a class="home-inline-link" href="/listings">View all products</a>
    </div>
    <div class="home-category-grid">
      <a class="home-category home-category-milk" href="/listings"><span class="home-category-number">01 / EVERYDAY</span><img src="/images/milk.jpeg" alt="Milk"><span class="home-category-name">Daily essentials</span></a>
      <a class="home-category home-category-ghee" href="/listings"><span class="home-category-number">02 / THE CLASSICS</span><img src="/images/ghee.jpeg" alt="Golden ghee"><span class="home-category-name">Rich &amp; golden</span></a>
      <a class="home-category home-category-paneer" href="/listings"><span class="home-category-number">03 / MADE TO SHARE</span><img src="/images/paneer.jpeg" alt="Paneer"><span class="home-category-name">Kitchen favourites</span></a>
      <a class="home-category home-category-treats" href="/listings"><span class="home-category-number">04 / A LITTLE TREAT</span><img src="/images/Ice_creams.jpeg" alt="Ice cream"><span class="home-category-name">Sweet moments</span></a>
    </div>
  </section>

  <section class="home-story" id="our-way" aria-labelledby="story-title">
    <div class="home-story-image"><img src="/bottom%20hero%20img.png" alt="Gavlee's samurai cow mascot presenting dairy favourites"></div>
    <div class="home-story-copy"><p class="home-kicker">A SIMPLE THING, DONE WITH CARE</p><h2 id="story-title">The little things<br>make a meal.</h2><p>Morning chai, a favourite family recipe, one last spoonful of dessert. Gavlee brings together the dairy staples and small delights that make everyday moments feel special.</p><a class="home-button home-button-green" href="/listings">Find your favourites</a></div>
  </section>

  <section class="home-endcap">
    <p class="home-kicker">YOUR NEXT FAVOURITE IS WAITING</p>
    <h2>Bring a little<br><em>Gavlee home.</em></h2>
    <a class="home-button home-button-light" href="/listings">Browse all products</a>
    <span class="home-endcap-flower" aria-hidden="true">✳</span>
  </section>
</main>
