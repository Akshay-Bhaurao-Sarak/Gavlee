<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gavlee</title>
</head>
<body>
    <h3>Add New Product</h3>
    <form method="POST" action="/listings">
        <input name="listing[title]" placeholder="Enter Product Name" type="text"/>
        <br><br/>
        <textarea name="listing[description]" placeholder="Enter Description"></textarea>
        <br><br/>
        <input name="listing[image]" placeholder="Enter image URL/Link" type="text"/>
        <br><br/>
        <input name="listing[flavours]" placeholder="Flavours, separated by commas (e.g. Mango, Strawberry)" type="text"/>
        <br><br/>
        <input name="listing[price]" placeholder="Enter price" type="String"/>
        <br><br/>
        <input name="listing[Nutrients]" placeholder="Enter Nutrients" type="text"/>
        <br><br/>
        <button>ADD</button>
    </form>
    
</body>
</html>