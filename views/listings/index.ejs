<% layout("/layouts/boilerplate")%>
<body>
<section class="hero-carousel" id="heroCarousel" tabindex="0" aria-label="Featured Gavlee products">
  <div class="hero-scene" id="heroScene" aria-live="polite">
    <div class="hero-copy">
      <p class="hero-eyebrow">FRESH FROM GAVLEE</p>
      <h1 id="heroTitle">Farm fresh goodness, every day</h1>
      <p id="heroDescription">Discover dairy favourites made with care and delivered with freshness.</p>
    </div>
    <img id="heroImage" src="/milk%20promo.png" alt="Fresh Gavlee milk">
  </div>
  <button class="hero-arrow hero-previous" type="button" aria-label="Previous featured product">&#10094;</button>
  <button class="hero-arrow hero-next" type="button" aria-label="Next featured product">&#10095;</button>
  <div class="hero-dots" id="heroDots" aria-label="Choose featured slide"></div>
</section>

<h3 style="padding: 1rem 0;">All Products</h3>
  <div id="products" class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
  <% for(let listing of allListings) { %>
  <% const savedFlavourOptions = (listing.flavourOptions || []).filter(option => option && option.name);
     const legacyFlavours = (listing.flavours || []).filter(Boolean);
     const defaultFlavourTitles = ["LASSI", "ICE CREAMS", "SHRIKHAND", "WHIPPED CREAM", "WHEY"];
     let cardFlavours = savedFlavourOptions.length ? savedFlavourOptions : legacyFlavours.map(name => ({ name, price: listing.price }));
     if (!cardFlavours.length && listing.hasFlavours !== false && defaultFlavourTitles.includes(listing.title.trim().toUpperCase())) {
       cardFlavours = ["Mango", "Strawberry", "Sweet Kesar", "Masala"].map(name => ({ name, price: listing.price }));
     }
  %>
  <div class="col listing-column">
  <div class="card listing-card">
    <img src="<%=listing.image%>" class="card-img-top listing-card-img" alt="<%= listing.title %>">
  <div class="card-body">         
    <h5 class="card-title"><a href="/listings/<%= listing._id %>" class="text-decoration-none text-reset"><%= listing.title %></a></h5>
    <p class="card-text"><%= listing.description %></p>
  </div>
  <ul class="list-group list-group-flush">
    <li class="list-group-item"><%= listing.Nutrients %></li>
    <% if (cardFlavours.length) { %>
    <li class="list-group-item listing-flavour-price-row">
      <label class="visually-hidden" for="flavour-select-<%= listing._id %>">Choose flavour</label>
      <select id="flavour-select-<%= listing._id %>" class="form-select product-flavour-select" aria-label="Choose flavour">
        <% cardFlavours.forEach((flavour, index) => { %>
        <option value="<%= flavour.name %>" data-price="<%= flavour.price %>" <%= index === 0 ? 'selected' : '' %>><%= flavour.name %></option>
        <% }) %>
      </select>
      <strong class="listing-flavour-price">₹<span class="product-flavour-price"><%= cardFlavours[0].price %></span></strong>
    </li>
    <% } else { %>
    <li class="list-group-item">₹<%= listing.price %></li>
    <% } %>
  </ul>
  <div class="card-body listing-card-actions">
    <a href="/listings/<%= listing._id %>/edit" class="btn btn-info">Edit Product</a>
    <button type="button" class="btn btn-success cart-add-button" data-id="<%= listing._id %>" data-title="<%= listing.title %>" data-image="<%= listing.image %>" data-price="<%= cardFlavours.length ? cardFlavours[0].price : listing.price %>">Add to cart</button>
    <div class="listing-quantity-picker" aria-label="Choose quantity">
      <span>Quantity</span>
      <div class="quantity-stepper">
        <button type="button" class="quantity-decrease" aria-label="Decrease quantity">−</button>
        <output class="quantity-value" aria-live="polite">1</output>
        <button type="button" class="quantity-increase" aria-label="Increase quantity">+</button>
      </div>
    </div>
  </div>
</div>
</div>
<% } %>
</div>
<script>
  (() => {
    const slides = [
      {
        image: "/milk%20promo.png",
        alt: "Fresh Gavlee cow milk",
        title: "Farm fresh goodness, every day",
        description: "Discover dairy favourites made with care and delivered with freshness."
      },
      {
        image: "/ghee%20promo.png",
        alt: "Gavlee pure cow ghee",
        title: "Bring home the richness of pure ghee",
        description: "Aromatic, golden and made for the meals you love."
      },
      {
        image: "/hero%20promo.png",
        alt: "Gavlee creamy ice cream",
        title: "A little delight in every scoop",
        description: "Explore creamy treats and other Gavlee favourites."
      }
    ];
    const scene = document.getElementById("heroScene");
    const image = document.getElementById("heroImage");
    const title = document.getElementById("heroTitle");
    const description = document.getElementById("heroDescription");
    const dots = document.getElementById("heroDots");
    let current = 0;
    let timer;
    let transitioning = false;

    slides.forEach((slide, index) => {
      const dot = document.createElement("button");
      dot.type = "button";
      dot.className = "hero-dot";
      dot.setAttribute("aria-label", `Show slide ${index + 1}`);
      dot.addEventListener("click", () => showSlide(index, index >= current ? 1 : -1));
      dots.appendChild(dot);
    });

    function syncDots() {
      [...dots.children].forEach((dot, index) => {
        dot.classList.toggle("active", index === current);
        dot.setAttribute("aria-current", index === current ? "true" : "false");
      });
    }

    function showSlide(index, direction) {
      if (transitioning || index === current) return;
      transitioning = true;
      scene.classList.add("is-transitioning", direction > 0 ? "from-next" : "from-previous");
      window.setTimeout(() => {
        current = (index + slides.length) % slides.length;
        image.src = slides[current].image;
        image.alt = slides[current].alt;
        title.textContent = slides[current].title;
        description.textContent = slides[current].description;
        syncDots();
        scene.classList.remove("is-transitioning", "from-next", "from-previous");
        transitioning = false;
      }, 240);
      resetTimer();
    }

    function nextSlide() { showSlide((current + 1) % slides.length, 1); }
    function previousSlide() { showSlide((current - 1 + slides.length) % slides.length, -1); }
    function resetTimer() {
      window.clearInterval(timer);
      timer = window.setInterval(nextSlide, 6000);
    }

    document.querySelector(".hero-next").addEventListener("click", nextSlide);
    document.querySelector(".hero-previous").addEventListener("click", previousSlide);
    document.getElementById("heroCarousel").addEventListener("click", event => {
      if (event.target.closest("button, a")) return;
      const bounds = event.currentTarget.getBoundingClientRect();
      if (event.clientX >= bounds.left + bounds.width / 2) nextSlide();
      else previousSlide();
    });
    document.getElementById("heroCarousel").addEventListener("keydown", event => {
      if (event.key === "ArrowRight") nextSlide();
      if (event.key === "ArrowLeft") previousSlide();
    });
    syncDots();
    resetTimer();
  })();
</script>
<script>
  document.querySelectorAll(".product-flavour-select").forEach(select => {
    select.addEventListener("change", () => {
      const selectedOption = select.selectedOptions[0];
      const price = select.closest(".listing-flavour-price-row").querySelector(".product-flavour-price");
      price.textContent = selectedOption.dataset.price;
    });
  });
</script>
<script>
  (() => {
    const cartKey = "gavleeCart";
    const readCart = () => { try { return JSON.parse(localStorage.getItem(cartKey) || "[]"); } catch { return []; } };
    const badge = document.querySelector(".navbar-cart-count");
    const syncBadge = () => {
      const count = readCart().reduce((sum, item) => sum + (Number(item.quantity) || 0), 0);
      if (badge) { badge.textContent = count; badge.hidden = count === 0; }
    };
    document.querySelectorAll(".cart-add-button").forEach(button => {
      button.addEventListener("click", () => {
        const card = button.closest(".listing-card");
        const quantity = Math.max(1, Number(card.querySelector(".quantity-value").textContent) || 1);
        const select = card.querySelector(".product-flavour-select");
        const option = select?.selectedOptions[0];
        const flavour = option?.value || "";
        const price = Number(option?.dataset.price || button.dataset.price);
        const item = { id: button.dataset.id, title: button.dataset.title, image: button.dataset.image, flavour, price };
        if (!Number.isFinite(price) || price < 0) return;
        const cart = readCart();
        const existing = cart.find(entry => entry.id === item.id && entry.flavour === item.flavour);
        if (existing) existing.quantity = (Number(existing.quantity) || 1) + quantity;
        else cart.push({ ...item, quantity });
        localStorage.setItem(cartKey, JSON.stringify(cart));
        syncBadge();
        const originalText = button.textContent;
        button.textContent = "Added to cart";
        window.setTimeout(() => { button.textContent = originalText; }, 1100);
      });
    });
    document.querySelectorAll(".listing-card").forEach(card => {
      const output = card.querySelector(".quantity-value");
      card.querySelector(".quantity-decrease").addEventListener("click", () => {
        output.textContent = Math.max(1, Number(output.textContent) - 1);
      });
      card.querySelector(".quantity-increase").addEventListener("click", () => {
        output.textContent = Number(output.textContent) + 1;
      });
    });
    syncBadge();
  })();
</script>
</body>


